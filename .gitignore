# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# venv
.venv/
venv/
env/

# Node / Vite
web/node_modules/
web/dist/
web/.vite/
.npm/
.pnpm-store/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp

# Runtime artifacts (supervisord pid/socket/childlogs)
var/

# Supervisord enabled/ is RUNTIME STATE, not source: the Admin UI's
# Enable/Disable buttons mutate this directory, and any git operation
# that touched these symlinks would silently override the user's
# choices. The set of "default-enabled" services lives in
# ``config/default-enabled.txt``; run_all.sh's seed_enabled_symlinks
# materializes the directory on first start (sentinel: ``enabled/.seeded``).
deploy/supervisor/enabled/*
!deploy/supervisor/enabled/.gitkeep

# Local override for service registry (if you ever do per-machine tweaks)
config/services.local.yaml

# Plans, ad-hoc notes
plans/
*.local.md

# Editor-generated
*.tmp
*.bak
