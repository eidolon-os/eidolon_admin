[Unit]
Description=Eidolon OS operator control plane
Wants=eidolond.service
After=local-fs.target eidolond.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
WorkingDirectory=/opt/eidolon/current/eidolon_admin
EnvironmentFile=-/etc/eidolon/admin.env
EnvironmentFile=/etc/eidolon/host.env
Environment=EIDOLON_WORKSPACE_ROOT=/opt/eidolon/current
Environment=EIDOLON_ROOT=/opt/eidolon/current
Environment=EIDOLON_PORTS_FILE=/opt/eidolon/current/eidolon_admin/config/ports.yaml
Environment=EIDOLON_ADMIN_SERVICES_FILE=/opt/eidolon/current/eidolon_admin/config/services.yaml
Environment=EIDOLON_ADMIN_STATE_DIR=/var/lib/eidolon/admin
Environment=EIDOLON_ADMIN_SUPERVISOR_AVAILABLE_DIR=/var/lib/eidolon/admin/supervisor/available
Environment=EIDOLON_ADMIN_SUPERVISOR_ENABLED_DIR=/var/lib/eidolon/admin/supervisor/enabled
Environment=EIDOLON_ADMIN_SYSTEM_DIRECTORY_UDS=/run/eidolon/system.sock
Environment=EIDOLON_ADMIN_API_HOST=127.0.0.1
Environment=EIDOLON_ADMIN_API_PORT=9000
ExecStart=/opt/eidolon/current/eidolon_admin/.venv/bin/eidolon-admin
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=20s
StateDirectory=eidolon/admin
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
