[Unit]
Description=Eidolon OS operator control plane
Wants=eidolond.service
After=local-fs.target eidolond.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
WorkingDirectory=/srv/eidolon/current/eidolon_admin
EnvironmentFile=-/etc/eidolon/admin.env
Environment=EIDOLON_ROOT=/srv/eidolon/current
Environment=EIDOLON_ADMIN_SERVICES_FILE=/srv/eidolon/current/eidolon_admin/config/services.yaml
Environment=EIDOLON_ADMIN_SYSTEM_DIRECTORY_UDS=/run/eidolon/system.sock
Environment=EIDOLON_ADMIN_API_HOST=127.0.0.1
Environment=EIDOLON_ADMIN_API_PORT=9000
ExecStart=/srv/eidolon/current/eidolon_admin/.venv/bin/eidolon-admin
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
