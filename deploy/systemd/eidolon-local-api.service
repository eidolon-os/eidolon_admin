[Unit]
Description=Eidolon OS authenticated local product API
Wants=eidolon-bootstrapd.service
After=local-fs.target eidolon-bootstrapd.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eidolon
Group=eidolon
SupplementaryGroups=eidolon-bootstrap
EnvironmentFile=-/etc/eidolon/local-api.env
Environment=EIDOLON_BOOTSTRAP_MODE=production
Environment=EIDOLON_BOOTSTRAP_STATE_DIR=/var/lib/eidolon-bootstrap
Environment=EIDOLON_BOOTSTRAP_RUNTIME_DIR=/run/eidolon-bootstrap
Environment=EIDOLON_LOCAL_API_HOST=127.0.0.1
Environment=EIDOLON_LOCAL_API_PORT=9002
ExecStart=/srv/eidolon/current/eidolon_admin/.venv/bin/eidolon-local-api
Restart=always
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
