[Service]
# Development-only drop-in. Install as:
#   /etc/systemd/system/eidolon-bootstrapd.service.d/development.conf
# Never include this file in a product image.
Environment=EIDOLON_BOOTSTRAP_MODE=development
Environment=EIDOLON_BOOTSTRAP_COMMISSIONING_ADAPTER=bluez
Environment=EIDOLON_BOOTSTRAP_NETWORK_ADAPTER=networkmanager
# There is no fixed Setup code to configure any more. Mint one when you need
# it, on this Host: eidolon-bootstrapctl commissioning-code
#
# Note what this drop-in actually produces: mode=development with the *real*
# adapters. That combination used to be refused by the LAN commissioning route
# while /api/local/v1/host still reported "mode": "development", so the route
# 404'd forever and looked like a network fault. Both transports now answer on
# every Host; this file only selects the hardware.
