[Unit]
Description=Eidolon OS device lifecycle workflow
Wants=eidolond.service
Requires=eidolon-admin.service
PartOf=eidolon-admin.service
After=local-fs.target eidolond.service eidolon-admin.service
Before=eidolon-local-api.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=eidolon-lifecycle
Group=eidolon-lifecycle-client
SupplementaryGroups=eidolon-lifecycle eidolon
WorkingDirectory=/opt/eidolon/current/eidolon_admin
EnvironmentFile=/etc/eidolon/host.env
Environment=EIDOLON_LIFECYCLE_STATE_DIR=/var/lib/eidolon-lifecycle
Environment=EIDOLON_LIFECYCLE_WORKFLOW_SOCKET=/run/eidolon-lifecycle/workflow.sock
Environment=EIDOLON_LIFECYCLE_SYSTEM_DIRECTORY_UDS=/run/eidolon/system.sock
Environment=EIDOLON_LIFECYCLE_REMOVAL_CAPABILITY_SOCKET=/run/eidolon-removal-capability/broker.sock
Environment=EIDOLON_LIFECYCLE_ALLOWED_LOCAL_API_USER=eidolon-local-api
ExecStart=/opt/eidolon/current/eidolon_admin/.venv/bin/eidolon-lifecycle-workflow
Restart=on-failure
RestartSec=1s
KillSignal=SIGTERM
TimeoutStartSec=20s
TimeoutStopSec=20s
StateDirectory=eidolon-lifecycle
StateDirectoryMode=0700
RuntimeDirectory=eidolon-lifecycle
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
