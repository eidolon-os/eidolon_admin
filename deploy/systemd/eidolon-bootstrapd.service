[Unit]
Description=Eidolon OS always-on bootstrap control plane
Wants=dbus.service bluetooth.service NetworkManager.service
After=local-fs.target dbus.service bluetooth.service NetworkManager.service
Before=eidolon-stack.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
User=eidolon-bootstrap
Group=eidolon-bootstrap
UMask=0007
EnvironmentFile=-/etc/eidolon/bootstrap.env
Environment=EIDOLON_BOOTSTRAP_MODE=production
Environment=EIDOLON_BOOTSTRAP_STATE_DIR=/var/lib/eidolon-bootstrap
Environment=EIDOLON_BOOTSTRAP_RUNTIME_DIR=/run/eidolon-bootstrap
ExecStart=/srv/eidolon/current/eidolon_admin/.venv/bin/eidolon-bootstrapd
Restart=always
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=15s
StateDirectory=eidolon-bootstrap
StateDirectoryMode=0700
RuntimeDirectory=eidolon-bootstrap
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
