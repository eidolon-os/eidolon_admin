      "DefaultCompanionRequest": {
        "additionalProperties": false,
        "description": "Which of my Eidolons answers when I did not say which.\n\n``expected_revision`` is not ceremony a client can skip: it is the version\nof the Owner it last read, and it is what makes two phones (or a phone and a\nbrowser) unable to both win. A client that has not read the Owner has no\nbusiness changing this.",
        "properties": {
          "companion_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Companion Id",
            "type": "string"
