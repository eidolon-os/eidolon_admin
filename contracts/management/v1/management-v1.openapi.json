              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "needs_confirmation": {
            "title": "Needs Confirmation",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "preview",
              "not_found",
              "too_broad"
            ],
            "title": "Status",
            "type": "string"
          },
          "target": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
