{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.local/contracts/local-api/v1/workspace-status.schema.json",
  "title": "Eidolon Local API Workspace Status V1",
  "type": "object",
  "required": ["contract_version", "operation_id", "state", "owner", "workspace"],
  "properties": {
    "contract_version": { "const": "1" },
    "operation_id": { "type": "string", "format": "uuid" },
    "state": { "enum": ["absent", "ready"] },
    "owner": {
      "type": ["object", "null"],
      "required": ["owner_id", "display_name", "lifecycle_state"],
      "properties": {
        "owner_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lifecycle_state": { "const": "active" }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": ["object", "null"],
      "required": [
        "state",
        "primary_companion_id",
        "persona_genome_id",
        "memory_realm_id"
      ],
      "properties": {
        "state": { "const": "ready" },
        "primary_companion_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "persona_genome_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "memory_realm_id": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "absent" } } },
      "then": {
        "properties": {
          "owner": { "type": "null" },
          "workspace": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "ready" } } },
      "then": {
        "properties": {
          "owner": { "type": "object" },
          "workspace": { "type": "object" }
        }
      }
    }
  ],
  "additionalProperties": false
}
