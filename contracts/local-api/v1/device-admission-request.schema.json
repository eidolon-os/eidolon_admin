{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eidolon.local/local-api/v1/device-admission-request.schema.json",
  "title": "Local Device approval request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id"],
  "properties": {
    "contract_version": {"const": "1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1, "maxLength": 128},
    "companion_id": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
