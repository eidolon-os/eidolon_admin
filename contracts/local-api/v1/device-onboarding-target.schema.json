{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eidolon.local/local-api/v1/device-onboarding-target.schema.json",
  "title": "Local Device onboarding target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "contract_version",
    "owner_domain_id",
    "owner_domain_descriptor",
    "owner_root_certificate",
    "authority_signing_certificate"
  ],
  "properties": {
    "operation": {"const": "local.device-onboarding-target"},
    "contract_version": {"const": "1"},
    "owner_domain_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner_domain_descriptor": {
      "$ref": "https://contracts.eidolon.live/device-foundation/v1/common/schemas.schema.json#/$defs/OwnerDomainDescriptor"
    },
    "owner_root_certificate": {
      "type": "string",
      "pattern": "^-----BEGIN CERTIFICATE-----",
      "maxLength": 4096
    },
    "authority_signing_certificate": {
      "type": "string",
      "pattern": "^-----BEGIN CERTIFICATE-----",
      "maxLength": 4096
    }
  }
}
