{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eidolon.local/local-api/v1/pending-device-enrollments.schema.json",
  "title": "Pending Device enrollments",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "contract_version", "devices"],
  "properties": {
    "operation": {"const": "local.pending-device-enrollments"},
    "contract_version": {"const": "1"},
    "devices": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "display_name", "device_kind", "enrolled_at"],
        "properties": {
          "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "display_name": {"type": "string", "maxLength": 128},
          "device_kind": {"type": "string", "minLength": 1, "maxLength": 96},
          "enrolled_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
