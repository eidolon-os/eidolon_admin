{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.local/contracts/bootstrap/v1/dev-commissioning-descriptor.schema.json",
  "title": "Eidolon Development Commissioning Descriptor V1",
  "type": "object",
  "required": [
    "contract_version",
    "host_id",
    "host_public_key",
    "host_public_key_fingerprint",
    "ble_service_uuid",
    "mode",
    "commissioning_id",
    "commissioning_secret",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "contract_version": { "const": "1" },
    "host_id": { "type": "string", "pattern": "^ehost-[0-9a-f]{20}$" },
    "host_public_key": { "type": "string", "minLength": 40, "maxLength": 64 },
    "host_public_key_fingerprint": { "type": "string", "pattern": "^sha256:" },
    "ble_service_uuid": { "type": "string", "format": "uuid" },
    "mode": { "const": "development" },
    "commissioning_id": { "type": "string", "format": "uuid" },
    "commissioning_secret": { "type": "string", "minLength": 32 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 80 }
  },
  "additionalProperties": false
}
