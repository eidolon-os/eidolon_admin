{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.local/contracts/bootstrap/v1/commissioning-response.schema.json",
  "title": "Eidolon Commissioning Response Envelope V1",
  "type": "object",
  "required": ["contract_version", "request_id", "ok"],
  "properties": {
    "contract_version": { "const": "1" },
    "request_id": { "type": ["string", "null"], "format": "uuid" },
    "ok": { "type": "boolean" },
    "result": { "type": "object" },
    "error": { "$ref": "error.schema.json" }
  },
  "oneOf": [
    {
      "properties": { "ok": { "const": true } },
      "required": ["result"],
      "not": { "required": ["error"] }
    },
    {
      "properties": { "ok": { "const": false } },
      "required": ["error"],
      "not": { "required": ["result"] }
    }
  ],
  "additionalProperties": false
}
