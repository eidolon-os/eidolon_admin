{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.local/contracts/bootstrap/v1/public-descriptor.schema.json",
  "title": "Eidolon Bootstrap Public Descriptor V1",
  "type": "object",
  "required": [
    "contract_version",
    "host_id",
    "host_public_key",
    "host_public_key_fingerprint",
    "ble_service_uuid"
  ],
  "properties": {
    "contract_version": { "const": "1" },
    "host_id": { "type": "string", "pattern": "^ehost-[0-9a-f]{20}$" },
    "host_public_key": { "type": "string", "minLength": 40, "maxLength": 64 },
    "host_public_key_fingerprint": { "type": "string", "pattern": "^sha256:" },
    "ble_service_uuid": { "type": "string", "format": "uuid" }
  },
  "additionalProperties": false
}
